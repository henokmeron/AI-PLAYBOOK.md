# Reference only. This web server does not load .env files.
# Export the variables in the shell, or point PLATFORM_API_KEY_FILE at a
# secret file. Never commit a real API key.

WEB_HOST=127.0.0.1
WEB_PORT=8080
PLATFORM_GATEWAY_URL=http://127.0.0.1:8010

# Registry id for the production default. The launcher sets this to qwen3.5-27b.
# Gemma is optional; do not put its checkpoint path here.
PLATFORM_MODEL_ID=qwen3.5-27b

# Preferred. The file is read by the web server and is not sent to the browser.
# Leave this unset to use the default path /tmp/platform-gateway.key.
# Set it to an empty value to use PLATFORM_API_KEY instead.
PLATFORM_API_KEY_FILE=/tmp/platform-gateway.key

# Local fake-gateway alternative only. Do not put a real key in this file.
# PLATFORM_API_KEY=

WEB_UPSTREAM_TIMEOUT=180
WEB_HEALTH_TIMEOUT=5

# Directory for named-operator accounts and sessions (mode 0600 files on POSIX).
# Default if unset: /tmp/console-operators on Linux, %LOCALAPPDATA%\AI-PLAYBOOK\console-operators on Windows.
# Provision the first admin with:
#   OPERATOR_AUTH_DIR=... python3 scripts/provision_console_operator.py create-admin --username alice
OPERATOR_AUTH_DIR=/tmp/console-operators

# Set true only when the browser reaches the console over HTTPS (Cookie Secure flag).
# Leave false for plain http://127.0.0.1 SSH tunnels.
WEB_COOKIE_SECURE=false
